                'success': False,
                'message': str(e)
            }), 400
    
    @staticmethod
    def get_contrats_expires():
        """Récupère les contrats qui arrivent à expiration"""
        try:
            contrats = ContratService.get_contrats_expires()
            
            contrats_data = []
            for contrat in contrats:
                contrats_data.append({
                    'id': contrat.id,
                    'personnel': {
