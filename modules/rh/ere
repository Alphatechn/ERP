@personnel_bp.route('/stats/overview', methods=['GET'])
def get_personnel_stats():
    """
    Statistiques générales du personnel
    Headers: Authorization: Bearer <token>
    
    Nécessite: permission 'view_personnel' ou 'manage_hr'
    """
    try:
        verify_jwt_in_request()
        claims = get_jwt()
        
        if 'view_personnel' not in claims.get('permissions', []) and 'manage_hr' not in claims.get('permissions', []):
            return jsonify({'error': 'Insufficient permissions'}), 403
        
        from .models import Personnel, Service, Conge, Absence
        from core.database import db
        
        # Statistiques de base
        stats = {
            'total_personnel': Personnel.query.filter_by(status='actif').count(),
            'personnel_par_service': dict(
                db.session.query(Service.libelle, db.func.count(Personnel.id))
                .join(Personnel)
                .filter(Personnel.status == 'actif')
                .group_by(Service.id).all()
            ),
            'conges_actifs': Conge.query.filter_by(status='approuve').filter(
                Conge.date_debut <= date.today(),
                Conge.date_fin >= date.today()
            ).count(),
            'absences_ce_mois': Absence.query.filter(
                db.extract('month', Absence.date_debut) == datetime.now().month,
                db.extract('year', Absence.date_debut) == datetime.now().year
            ).count()
        }
        
        return jsonify({
            'success': True,
            'data': stats,
            'generated_by': claims.get('username'),
            'timestamp': datetime.utcnow().isoformat()
        })
        
    except Exception as e:
        return jsonify({
            'success': False,
            'message': str(e)
        }), 400