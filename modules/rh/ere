class DocumentController:
    """Contrôleur pour la gestion des documents du personnel"""
    
    @staticmethod
    def upload_document(personnel_id):
        """Upload un document pour un personnel"""
        try:
            from flask import request
            
            if 'file' not in request.files:
                return jsonify({
                    'success': False,
                    'message': 'Aucun fichier fourni'
                }), 400
            
            file = request.files['file']
            libelle = request.form.get('libelle')
            
            if not libelle:
                return jsonify({
                    'success': False,
                    'message': 'Libellé du document requis'
                }), 400
            
            document = DocumentService.upload_document(personnel_id, file, libelle)
            
            return jsonify({
                'success': True,
                'message': 'Document uploadé avec succès',
                'data': {
                    'id': document.id,
                    'libelle': document.libelle,
                    'url_fichier': document.url_fichier
                }
            }), 201
            
        except Exception as e:
            return jsonify({
                'success': False,
                'message': str(e)
            }), 400
    
    @staticmethod
    def get_personnel_documents(personnel_id):
        """Récupère tous les documents d'un personnel"""
        try:
            documents = DocumentService.get_personnel_documents(personnel_id)
            
            documents_data = []
            for document in documents:
                documents_data.append({
                    'id': document.id,
                    'libelle': document.libelle,
                    'url_fichier': document.url_fichier,
                    'date_creation': document.date_creation.isoformat()
                })
            
            return jsonify({
                'success': True,
                'data': documents_data
            })
            
        except Exception as e:
            return jsonify({
                'success': False,
                'message': str(e)
            }), 400
    
    @staticmethod
    def delete_document(document_id):
        """Supprime un document"""
        try:
            DocumentService.delete_document(document_id)
            
            return jsonify({
                'success': True,
                'message': 'Document supprimé avec succès'
            })
            
        except Exception as e:
            return jsonify({
                'success': False,
                'message': str(e)
            }), 400

class AbsenceController:
    """Contrôleur pour la gestion des absences"""
    
    @staticmethod
    def create_absence():
        """Enregistre une absence"""
        try:
            data = request.get_json()
            
            absence = AbsenceService.create_absence(
                personnel_id=data.get('personnel_id'),
                libelle=data.get('libelle'),
                date_debut=datetime.strptime(data.get('date_debut'), '%Y-%m-%d').date(),
                date_fin=datetime.strptime(data.get('date_fin'), '%Y-%m-%d').date(),
                motif=data.get('motif'),
                justifiee=data.get('justifiee', False)
            )
            
            return jsonify({
