def employee_bulletin(exercice_id):
    """
    [EMPLOYÉ] Bulletin de paie de l'employé connecté
    Headers: Authorization: Bearer <token>
    """
    try:
        verify_jwt_in_request()
        user_id = get_jwt_identity()
        
        from .models import Personnel
        personnel = Personnel.query.filter_by(user_id=user_id).first()
        
        if not personnel:
            return jsonify({'error': 'Personnel profile not found'}), 404
        
        return PayrollController.get_bulletin_paie(personnel.id, exercice_id)
        
    except Exception as e:
        return jsonify({'error': f'Failed to retrieve payslip: {str(e)}'}), 500

