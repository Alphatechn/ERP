@personnel_bp.route('/export/personnel-list', methods=['GET'])
def export_personnel_list():
    """
    Export de la liste du personnel (CSV/Excel)
    Headers: Authorization: Bearer <token>
    
    Query Params:
    - format: csv|excel (défaut: csv)
    - service_id: int (filt`re par service, optionnel)
    
    Nécessite: permission 'manage_hr' ou 'view_personnel'
    """
    verify_jwt_in_request()
    claims = get_jwt()
    
    if 'manage_hr' not in claims.get('permissions', []) and 'view_personnel' not in claims.get('permissions', []):
        return jsonify({'error': 'Insufficient permissions'}), 403
    
    format_export = request.args.get('format', 'csv')
    service_id = request.args.get('service_id', type=int)
    
    return PersonnelController.export_personnel_list(format_export, service_id)

