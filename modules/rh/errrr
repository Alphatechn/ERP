@personnel_bp.route('/employee/profile', methods=['GET'])
def employee_profile():
    """
    [EMPLOYÉ] Profil de l'employé connecté
    Headers: Authorization: Bearer <token>
    
    Permet à un employé de voir ses propres informations
    """
    try:
        verify_jwt_in_request()
        user_id = get_jwt_identity()
        claims = get_jwt()
        
        # Trouver le personnel associé à cet utilisateur
        from .models import Personnel
        personnel = Personnel.query.filter_by(user_id=user_id).first()
        
        if not personnel:
            return jsonify({
                'error': 'Aucun profil personnel trouvé pour cet utilisateur'
            }), 404
        
        # Récupérer les détails
        from .services import PersonnelService
        details = PersonnelService.get_personnel_details(personnel.id)
        
        if not details:
            return jsonify({'error': 'Détails du personnel introuvables'}), 404
        
        profile_data = {
            'personnel': {
                'matricule': details['personnel'].matricule,
                'nom_complet': details['personnel'].nom_complet,
                'service': details['service'].libelle,
                'poste': details['poste'].fonction,
                'date_embauche': details['personnel'].date_embauche.isoformat(),
                'telephone': details['personnel'].telephone,
                'adresse': details['personnel'].adresse
            },
            'contrat_actuel': details['contrat_actuel'].__dict__ if details['contrat_actuel'] else None,
            'statistiques': details['statistiques']
        }
        
        return jsonify({
            'message': 'Employee profile retrieved',
            'data': profile_data,
            'username': claims.get('username')
        }), 200
        
    except Exception as e:
        return jsonify({'error': f'Profile retrieval failed: {str(e)}'}), 500

