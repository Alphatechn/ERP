@personnel_bp.route('/admin/stats', methods=['GET'])
def admin_stats():
    """
    [ADMINISTRATEUR] Statistiques globales du personnel
    Headers: Authorization: Bearer <token>
    
    Nécessite: user_type='administrateur' ET niveau_acces='complet'
    """
    try:
        verify_jwt_in_request()
        claims = get_jwt()
        
        if claims.get('user_type') != 'administrateur' or claims.get('niveau_acces') != 'complet':
            return jsonify({'error': 'Access restricted to administrators with full access'}), 403
        
        from .models import Personnel, Service, Poste, Conge, Absence, Contrat, Exercice
        from core.database import db
        
        # Statistiques globales
        stats = {
            'personnel': {
                'total': Personnel.query.count(),
                'actifs': Personnel.query.filter_by(status='actif').count(),
                'inactifs': Personnel.query.filter(Personnel.status != 'actif').count()
            },
            'structure': {
                'services': Service.query.filter_by(status='actif').count(),
                'postes': Poste.query.filter_by(status='actif').count()
            },
            'conges': {
                'en_attente': Conge.query.filter_by(status='demande').count(),
                'approuves': Conge.query.filter_by(status='approuve').count(),
                'rejetes': Conge.query.filter_by(status='rejete').count()
            },
            'absences': {
                'total_ce_mois': Absence.query.filter(
                    db.extract('month', Absence.date_debut) == datetime.now().month
                ).count()
            },
            'contrats': {
                'actifs': Contrat.query.filter_by(status='actif').count(),
                'expires_bientot': len(ContratService.get_contrats_expires())
            },
            'paie': {
                'exercices_ouverts': Exercice.query.filter_by(status='ouvert').count(),
                'exercices_clos': Exercice.query.filter_by(status='clos').count()
            }
        }
        
        return jsonify({
            'message': 'Global personnel statistics',
            'stats': stats,
            'admin': claims.get('username'),
            'timestamp': datetime.utcnow().isoformat()
        }), 200
        
    except Exception as e:
        return jsonify({'error': f'Admin stats failed: {str(e)}'}), 500

